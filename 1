<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Тряпичная кукла 3D</title>
<style>
*{box-sizing:border-box}
body{margin:0;overflow:hidden;background:#090914;color:white;font-family:Arial,sans-serif;touch-action:none}
#info{position:fixed;top:12px;left:12px;right:12px;padding:12px;border-radius:24px;background:#17172b;text-align:center;border:1px solid #34344a;z-index:5}
#help{position:fixed;bottom:12px;left:12px;right:12px;padding:12px;border-radius:20px;background:#17172b;text-align:center;color:#bbc1d6;font-size:13px;z-index:5}
#err{position:fixed;top:25%;left:15px;right:15px;background:#401b26;color:white;padding:18px;border-radius:15px;white-space:pre-wrap;z-index:20}
canvas{display:block;touch-action:none}
</style>
</head>
<body>
<div id="info">🧵 Тряпичная кукла — тяни, кидай, мни</div>
<div id="help">Палец / мышь — хватай и тяни • Два пальца — вращение и масштаб</div>
<div id="err" style="display:none"></div>

<script type="module">
const errorBox=document.getElementById('err');
function showError(e){
 errorBox.style.display='block';
 errorBox.textContent='Ошибка запуска:\n'+(e?.stack||e?.message||e);
}
try {
 let THREE,CANNON;
 try {
  THREE=await import('https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.module.js');
  CANNON=await import('https://cdn.jsdelivr.net/npm/cannon-es@0.20.0/dist/cannon-es.js');
 } catch(e) {
  THREE=await import('https://esm.sh/three@0.128.0');
  CANNON=await import('https://esm.sh/cannon-es@0.20.0');
 }

 // СЦЕНА
 const scene=new THREE.Scene();
 scene.background=new THREE.Color(0x090914);
 scene.fog=new THREE.Fog(0x090914,12,30);

 const camera=new THREE.PerspectiveCamera(50,innerWidth/innerHeight,.1,100);
 camera.position.set(4,3.5,7);
 camera.lookAt(0,1.8,0);

 const renderer=new THREE.WebGLRenderer({antialias:true});
 renderer.setSize(innerWidth,innerHeight);
 renderer.setPixelRatio(Math.min(devicePixelRatio,1.5));
 renderer.shadowMap.enabled=true;
 document.body.appendChild(renderer.domElement);

 scene.add(new THREE.HemisphereLight(0xbac8ff,0x292035,2));
 const light=new THREE.DirectionalLight(0xffdfbd,2.5);
 light.position.set(4,8,5);
 light.castShadow=true;
 scene.add(light);

 // ПОЛ И СЕТКА
 const floor=new THREE.Mesh(
  new THREE.CircleGeometry(8,64),
  new THREE.MeshStandardMaterial({color:0x202038,roughness:.9})
 );
 floor.rotation.x=-Math.PI/2;
 floor.receiveShadow=true;
 scene.add(floor);
 const grid=new THREE.GridHelper(16,32,0x555577,0x303047);
 grid.position.y=.01;
 scene.add(grid);

 // ФИЗИКА
 const world=new CANNON.World();
 world.gravity.set(0,-9.82,0);
 world.broadphase=new CANNON.SAPBroadphase(world);
 world.solver.iterations=10;
 world.defaultContactMaterial.friction=.5;
 world.defaultContactMaterial.restitution=.12;

 const ground=new CANNON.Body({mass:0});
 ground.addShape(new CANNON.Plane());
 ground.quaternion.setFromEuler(-Math.PI/2,0,0);
 world.addBody(ground);

 const bodies=[],meshes=[];
 function part(name,size,pos,mass,color,shapeType='box'){
  let shape;
  if(shapeType==='sphere') shape=new CANNON.Sphere(size[0]);
  else shape=new CANNON.Box(new CANNON.Vec3(size[0]/2,size[1]/2,size[2]/2));
  const b=new CANNON.Body({mass,position:new CANNON.Vec3(...pos)});
  b.addShape(shape);
  b.linearDamping=.04;
  b.angularDamping=.12;
  world.addBody(b);

  let geo=shapeType==='sphere'
   ?new THREE.SphereGeometry(size[0],24,18)
   :new THREE.BoxGeometry(...size);
  const m=new THREE.Mesh(geo,new THREE.MeshStandardMaterial({color,roughness:.7}));
  m.castShadow=true;m.receiveShadow=true;
  scene.add(m);
  bodies.push(b);meshes.push(m);
  b.userData.name=name;
  return b;
 }
 function joint(a,b,pa,pb){
  world.addConstraint(new CANNON.PointToPointConstraint(
   a,new CANNON.Vec3(...pa),b,new CANNON.Vec3(...pb),1e5
  ));
 }

 // КУКЛА
 const pelvis=part('Таз',[.65,.4,.42],[0,2,0],4,0xc08c65);
 const torso=part('Торс',[.65,.85,.4],[0,2.65,0],5,0xb9815d);
 const head=part('Голова',[.34],[0,3.35,0],1.5,0xffd0ad,'sphere');

 joint(pelvis,torso,[0,.2,0],[0,-.42,0]);
 joint(torso,head,[0,.43,0],[0,-.3,0]);

 const limbs=[];
 function makeLimb(name,a,b,size,color){
  const mid=[(a[0]+b[0])/2,(a[1]+b[1])/2,0];
  const limb=part(name,size,mid,1.4,color);
  limbs.push(limb);
  return limb;
 }

 // Руки
 const lua=makeLimb('Левое плечо',[-.4,2.9,0],[-.9,2.55,0],[.25,.65,.25],0xb88764);
 const lla=makeLimb('Левое предплечье',[-.9,2.55,0],[-1.25,2.15,0],[.22,.65,.22],0xb88764);
 const rua=makeLimb('Правое плечо',[.4,2.9,0],[.9,2.55,0],[.25,.65,.25],0xb88764);
 const rla=makeLimb('Правое предплечье',[.9,2.55,0],[1.25,2.15,0],[.22,.65,.22],0xb88764);

 joint(torso,lua,[-.33,.35,0],[0,.3,0]);
 joint(lua,lla,[0,-.32,0],[0,.32,0]);
 joint(torso,rua,[.33,.35,0],[0,.3,0]);
 joint(rua,rla,[0,-.32,0],[0,.32,0]);

 // Ноги
 const lul=makeLimb('Левое бедро',[-.2,1.75,0],[-.25,1.05,0],[.3,.72,.3],0x8b7656);
 const lll=makeLimb('Левая голень',[-.25,1.05,0],[-.3,.35,0],[.25,.72,.25],0x8b7656);
 const rul=makeLimb('Правое бедро',[.2,1.75,0],[.25,1.05,0],[.3,.72,.3],0x8b7656);
 const rll=makeLimb('Правая голень',[.25,1.05,0],[.3,.35,0],[.25,.72,.25],0x8b7656);

 joint(pelvis,lul,[-.22,-.18,0],[0,.35,0]);
 joint(lul,lll,[0,-.35,0],[0,.35,0]);
 joint(pelvis,rul,[.22,-.18,0],[0,.35,0]);
 joint(rul,rll,[0,-.35,0],[0,.35,0]);

 // ПОДТАЛКИВАЕМ КУКЛУ
 pelvis.applyImpulse(new CANNON.Vec3(.3,.7,0));

 // ХВАТАНИЕ
 const ray=new THREE.Raycaster();
 const pointer=new THREE.Vector2();
 const plane=new THREE.Plane();
 const hitPoint=new THREE.Vector3();
 const offset=new THREE.Vector3();
 let grabbed=null,grabId=null;
 let pointers=new Map();
 let rotate=false,lastX=0,lastY=0;
 let angle=0,camDist=8,camY=3.5;

 function cameraUpdate(){
  camera.position.set(Math.sin(angle)*camDist,camY,Math.cos(angle)*camDist);
  camera.lookAt(0,1.8,0);
 }
 function coords(e){
  pointer.x=e.clientX/innerWidth*2-1;
  pointer.y=-(e.clientY/innerHeight)*2+1;
 }
 renderer.domElement.addEventListener('pointerdown',e=>{
  renderer.domElement.setPointerCapture(e.pointerId);
  pointers.set(e.pointerId,{x:e.clientX,y:e.clientY});
  if(pointers.size>=2){
   grabbed=null;grabId=null;rotate=true;
   lastX=e.clientX;lastY=e.clientY;
   return;
  }
  coords(e);ray.setFromCamera(pointer,camera);
  const hit=ray.intersectObjects(meshes)[0];
  if(hit){
   const i=meshes.indexOf(hit.object);
   grabbed=bodies[i];grabId=e.pointerId;
   offset.copy(hit.point).sub(grabbed.position);
   plane.setFromNormalAndCoplanarPoint(camera.getWorldDirection(new THREE.Vector3()),hit.point);
   e.preventDefault();
  }else{
   rotate=true;lastX=e.clientX;lastY=e.clientY;
  }
 });
 window.addEventListener('pointermove',e=>{
  if(!pointers.has(e.pointerId))return;
  const prev=pointers.get(e.pointerId);
  pointers.set(e.pointerId,{x:e.clientX,y:e.clientY});
  if(pointers.size>=2){
   const p=[...pointers.values()];
   const d=Math.hypot(p[0].x-p[1].x,p[0].y-p[1].y);
   camDist=Math.max(3,Math.min(15,camDist-(d-prev.d||0)*.01));
   angle+=(e.clientX-lastX)*.006;
   camY=Math.max(1,Math.min(7,camY+(e.clientY-lastY)*.02));
   lastX=e.clientX;lastY=e.clientY;
   cameraUpdate();return;
  }
  if(grabbed&&grabId===e.pointerId){
   coords(e);ray.setFromCamera(pointer,camera);
   if(ray.ray.intersectPlane(plane,hitPoint)){
    grabbed.userData.target=hitPoint.clone().sub(offset);
   }
  }else if(rotate){
   angle+=(e.clientX-lastX)*.008;
   camY=Math.max(1,Math.min(7,camY+(e.clientY-lastY)*.02));
   lastX=e.clientX;lastY=e.clientY;cameraUpdate();
  }
 },{passive:false});
 function release(e){
  pointers.delete(e.pointerId);
  if(grabId===e.pointerId){
   if(grabbed)delete grabbed.userData.target;
   grabbed=null;grabId=null;
  }
  rotate=false;
 }
 window.addEventListener('pointerup',release);
 window.addEventListener('pointercancel',release);

 // АНИМАЦИЯ
 const clock=new THREE.Clock();
 function animate(){
  requestAnimationFrame(animate);
  const dt=Math.min(clock.getDelta(),.033);
  for(const b of bodies){
   const target=b.userData.target;
   if(target){
    const diff=target.vsub(b.position);
    b.applyForce(diff.scale(350).vsub(b.velocity.scale(22)),b.position);
   }
  }
  world.step(1/60,dt,3);
  bodies.forEach((b,i)=>{
   meshes[i].position.copy(b.position);
   meshes[i].quaternion.copy(b.quaternion);
  });
  renderer.render(scene,camera);
 }
 animate();

 window.addEventListener('resize',()=>{
  camera.aspect=innerWidth/innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth,innerHeight);
 });
 cameraUpdate();

} catch(e) {showError(e);}
</script>
</body>
</html>